/**
 * Создаёт Google Form с автопроверкой ответов.
 */
function createEnglexQuiz() {
  var form = FormApp.create('Тест на проверку усвоения информации');
  form.setDescription('День 1: Знакомство с брендом. 30 вопросов, 7 блоков.');
  form.setIsQuiz(true);
  form.setProgressBar(true);
  form.setShuffleQuestions(false);
  form.setConfirmationMessage('Спасибо! Вы завершили тест. Результат показан ниже.');

  QUIZ_SECTIONS.forEach(function(section, sectionIndex) {
    if (sectionIndex > 0) {
      form.addPageBreakItem().setTitle(section.title);
    } else {
      form.addSectionHeaderItem().setTitle(section.title);
    }

    section.questions.forEach(function(q) {
      addQuizQuestion(form, q);
    });
  });

  var editUrl = form.getEditUrl();
  var publishUrl = form.getPublishedUrl();

  Logger.log('Форма создана!');
  Logger.log('Редактирование: ' + editUrl);
  Logger.log('Ссылка для прохождения: ' + publishUrl);

  try {
    SpreadsheetApp.getUi().alert(
      'Форма создана!\n\n' +
      'Ссылка для прохождения:\n' + publishUrl + '\n\n' +
      'Редактирование:\n' + editUrl
    );
  } catch (e) {
    // Запуск не из таблицы — ссылки только в журнале
  }

  return publishUrl;
}

function addQuizQuestion(form, q) {
  var correctLetter = ANSWERS[q.num];
  var correctIndex = LETTER_TO_INDEX[correctLetter];

  if (correctIndex === undefined) {
    throw new Error('Нет ответа для вопроса ' + q.num);
  }

  var item = form.addMultipleChoiceItem();
  item.setTitle(q.num + '. ' + q.text);
  item.setPoints(1);
  item.setRequired(true);

  var choices = q.options.map(function(optionText, index) {
    return item.createChoice(optionText, index === correctIndex);
  });

  item.setChoices(choices);
}
